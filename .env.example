# Copia este ficheiro para .env.local e preenche os valores.
# Os passos para encontrar cada um estão explicados no README.md.

# --- Supabase (Fase 1) ---------------------------------------------------
# Project Settings → API, no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role" — secreta, nunca a partilhes nem a exponhas no browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (Fase 1) --------------------------------------------------------
# Endereço onde o site corre. Em desenvolvimento fica o valor por omissão.
# Em produção, o endereço definitivo (ex: https://revista.pedrocorreiaoficial.pt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Administradores (Fase 1) ---------------------------------------------
# Emails com acesso ao /painel, separados por vírgula, sem espaços.
# O MESMO valor também tem de ser definido na base de dados — ver
# supabase/migrations/0001_init.sql e o README, secção "Administradores".
ADMIN_EMAILS=

# --- Conversão (Fase 4) ----------------------------------------------------
# Destino do botão "Falar comigo" no fim de cada artigo.
CTA_DESTINO=https://pedrocorreiaoficial.pt/mentoria

# --- Notificações de comentários (Fase 5) ----------------------------------
# Chave da conta Resend (resend.com) usada para enviar o email de aviso de
# comentário novo, e o email do Pedro que deve recebê-lo.
RESEND_API_KEY=
ADMIN_EMAIL=

# Opcional — um endereço próprio (ex: um webhook do Zapier/Make/atalho do
# telemóvel) que recebe o mesmo aviso em JSON. Deixa em branco para não usar.
NOTIFY_WEBHOOK_URL=

# --- CRM / leads (Fase 6) ---------------------------------------------------
# "webhook" para enviar cada lead a um CRM externo por POST, ou "nenhum" para
# só guardar na base de dados.
CRM_PROVIDER=nenhum
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
